---
/**
 * Hero „Lichtkante“: Die Bühne ist zuerst komplett schwarz, nur die Schlagzeile steht
 * da. Beim Scrollen fährt eine harte Lichtkante von links nach rechts und legt das
 * farbige Foto Stück für Stück frei – bis die Maschine ganz im Licht steht.
 *
 * Alles läuft über transform (nur Compositor, kein Layout, kein Neuzeichnen): Ein Rahmen
 * fährt von links herein und schneidet ab, das Foto darin läuft gegenläufig und bleibt
 * so auf der Stelle; die Lichtkante sitzt auf einer Schiene an der Rahmenkante.
 * Ohne JavaScript und bei reduzierter Bewegung steht das Foto ausgeleuchtet da.
 */
import Bild from '../Bild.astro';
import Fit from '../Fit.astro';
import Pfeil from '../Pfeil.astro';
import Leiste from './Leiste.astro';
import Einstieg from './Einstieg.astro';
import { edition } from '../../data/editionen';
import { bild } from '../../lib/bilder';

const e = edition('r-1300-gs-triple-black');
const foto = bild(`editionen/${e.slug}-2`);
---

<section class="lk" data-lk data-theme="dark" data-kopf="dunkel">
  <div class="lk__buehne">
    <div class="lk__rahmen" data-lk-rahmen>
      <div class="lk__lage" data-lk-lage>
        <Bild src={foto} alt={`${e.titel} auf einer beleuchteten Bühne in der Werkhalle`} sizes="100vw" widths={[960, 1280, 1800]} eager fokus="50% 46%" />
      </div>
    </div>
    <div class="lk__schiene" data-lk-schiene aria-hidden="true">
      <div class="lk__glanz"></div>
      <div class="lk__kante"></div>
    </div>
    <div class="lk__schleier" aria-hidden="true"></div>
  </div>

  <div class="lk__inhalt wrap">
    <Leiste />
    <div class="lk__titel">
      <Fit tag="h1" lines={['Kein gewöhnlicher', 'BMW Partner.']} linesSm={['Kein', 'gewöhnlicher', 'BMW Partner.']} label="Kein gewöhnlicher BMW Partner." />
    </div>
    <div class="lk__unten" data-hero-vorn>
      <Einstieg />
      <p class="lk__hinweis label label--dim">Im Bild: BMW {e.basis} {e.name} · Martin Edition Nº {e.nr}</p>
    </div>
    <a class="lk__etikett" href={`/martin-edition/${e.slug}/`} data-lk-etikett>
      <span class="label">Martin Edition · Katalog Nº {e.nr}</span>
      <span class="lk__etikett-name">BMW {e.basis} {e.name}</span>
      <span class="link">Zur Edition <Pfeil /></span>
    </a>
  </div>
</section>

<style>
  .lk {
    position: relative;
    height: 100svh;
    min-height: 40rem;
    overflow: clip;
    background: var(--night);
    color: var(--fg);
  }
  .lk__buehne,
  .lk__rahmen,
  .lk__lage,
  .lk__schiene,
  .lk__schleier {
    position: absolute;
    inset: 0;
  }
  .lk__rahmen {
    overflow: hidden;
  }
  .lk__rahmen,
  .lk__lage,
  .lk__schiene {
    will-change: transform;
    backface-visibility: hidden;
  }
  .lk__lage :global(.bild) {
    width: 100%;
    height: 100%;
    background: var(--night);
  }
  /* Mit Skript zuerst komplett schwarz: Rahmen links draußen, Licht aus */
  :global(.js) .lk__rahmen {
    transform: translate3d(-100%, 0, 0);
  }
  :global(.js) .lk__lage {
    transform: translate3d(100%, 0, 0);
  }
  .lk__schiene {
    pointer-events: none;
    opacity: 0;
  }
  /* Lichtkante: harte Linie am linken Rand der Schiene, davor ein Streifen Überstrahlung */
  .lk__kante {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 2px;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.25), rgb(255 255 255 / 0.95) 18%, rgb(255 255 255 / 0.95) 82%, rgb(255 255 255 / 0.25));
    box-shadow:
      0 0 14px 2px rgb(255 255 255 / 0.3),
      0 0 70px 10px rgb(255 255 255 / 0.1);
  }
  .lk__glanz {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100%;
    width: 18vw;
    background: linear-gradient(to right, transparent, rgb(255 255 255 / 0.06) 65%, rgb(255 255 255 / 0.18));
  }
  .lk__schleier {
    background:
      linear-gradient(to bottom, rgb(11 12 12 / 0.6), transparent 34%),
      linear-gradient(to top, rgb(11 12 12 / 0.85), transparent 46%);
    pointer-events: none;
  }

  .lk__inhalt {
    position: relative;
    z-index: 2;
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr auto;
    padding-top: calc(var(--header-h) + clamp(0.5rem, 2vh, 1.5rem));
    padding-bottom: var(--pad);
  }
  .lk__titel {
    padding-top: clamp(1rem, 3vh, 2.25rem);
  }
  .lk__unten {
    grid-row: 4;
    grid-column: 1;
    display: grid;
    grid-template-columns: minmax(0, 10fr) minmax(0, 2fr);
    gap: 1.5rem var(--gap);
    align-items: end;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-2);
  }
  .lk__hinweis {
    justify-self: end;
    text-align: right;
    max-width: 14rem;
  }
  .lk__etikett {
    grid-row: 4;
    grid-column: 1;
    align-self: end;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    opacity: 0;
    visibility: hidden;
  }
  .lk__etikett-name {
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.6rem);
    font-weight: 780;
    font-stretch: 112%;
    letter-spacing: -0.03em;
    line-height: 0.98;
    text-transform: uppercase;
  }
  @media (max-width: 1100px) {
    .lk__unten {
      grid-template-columns: minmax(0, 1fr);
    }
    .lk__hinweis {
      display: none;
    }
  }
  @media (max-width: 899px) {
    .lk {
      height: auto;
      min-height: 0;
    }
    .lk__inhalt {
      min-height: 100svh;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { bereit } from '../../scripts/bereit';

  function lichtkante() {
    const sektion = document.querySelector<HTMLElement>('[data-lk]');
    if (!sektion) return;
    const rahmen = sektion.querySelector<HTMLElement>('[data-lk-rahmen]')!;
    const lage = sektion.querySelector<HTMLElement>('[data-lk-lage]')!;
    const schiene = sektion.querySelector<HTMLElement>('[data-lk-schiene]')!;
    const etikett = sektion.querySelector<HTMLElement>('[data-lk-etikett]')!;
    const vorn = Array.from(sektion.querySelectorAll<HTMLElement>('.lk__inhalt > [data-hero-vorn]'));
    const titel = sektion.querySelector<HTMLElement>('.lk__titel')!;
    const ruhig = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const buehne = matchMedia('(min-width: 900px) and (min-height: 600px)').matches;

    // a: Wert ohne Scroll (Handy-Durchlauf), b: Scrollweg – sichtbar ist das Maximum (0–100)
    const licht = { a: 0, b: 0, an: 0 };
    const zeichne = () => {
      const x = Math.max(licht.a, licht.b);
      rahmen.style.transform = `translate3d(${x - 100}%, 0, 0)`;
      lage.style.transform = `translate3d(${100 - x}%, 0, 0)`;
      schiene.style.transform = `translate3d(${x}%, 0, 0)`;
      schiene.style.opacity = String(x <= 0 || x >= 100 ? 0 : licht.an);
    };

    if (ruhig) {
      licht.a = 100;
      zeichne();
    } else if (buehne) {
      // Zuerst komplett schwarz – das Licht kommt erst mit dem Scrollen
      zeichne();
    } else {
      // Handy: nach kurzer Dunkelheit einmal komplett ausleuchten, ohne Scrollbindung
      licht.an = 1;
      zeichne();
      gsap.to(licht, { a: 100, duration: 3.2, ease: 'power2.inOut', delay: 1, onUpdate: zeichne });
    }

    const mm = gsap.matchMedia();
    mm.add('(min-width: 900px) and (min-height: 600px) and (prefers-reduced-motion: no-preference)', () => {
      const tl = gsap.timeline({
        scrollTrigger: { trigger: sektion, start: 'top top', end: '+=90%', pin: true, scrub: 0.5, anticipatePin: 1, refreshPriority: 10 },
      });
      tl.fromTo(licht, { an: 0 }, { an: 1, duration: 0.03, ease: 'none', immediateRender: false, onUpdate: zeichne }, 0)
        .fromTo(licht, { b: 0 }, { b: 100, duration: 0.7, ease: 'none', immediateRender: false, onUpdate: zeichne }, 0.02)
        .to(vorn, { opacity: 0, y: -12, duration: 0.14, ease: 'power1.in' }, 0.3)
        .to(titel, { opacity: 0, duration: 0.2, ease: 'power1.in' }, 0.4)
        .fromTo(etikett, { autoAlpha: 0, y: 24 }, { autoAlpha: 1, y: 0, duration: 0.18, ease: 'power2.out' }, 0.76);
      return () => {
        licht.b = 0;
        licht.an = 0;
        zeichne();
        gsap.set([etikett, titel, ...vorn], { clearProps: 'all' });
      };
    });
    // Der Auftakt wird erst nach der Galerie angelegt: Reihenfolge herstellen und neu berechnen
    ScrollTrigger.sort();
    ScrollTrigger.refresh();
    // Zustand für die automatische Prüfung lesbar machen
    (sektion as HTMLElement & { __licht?: typeof licht }).__licht = licht;
  }
  bereit(lichtkante);
</script>
