---
/**
 * Hero-Variante „Drei Häuser“: Typenschild-Schlagzeile über drei hohen Bildsäulen –
 * Weyarn, Schongau, Oy-Mittelberg, jeweils mit Live-Status. Beim Scrollen gleiten die
 * Säulen unterschiedlich schnell und die Schlagzeile teilt sich. Nichts wird festgehalten.
 */
import Bild from '../Bild.astro';
import Fit from '../Fit.astro';
import Pfeil from '../Pfeil.astro';
import Status from '../Status.astro';
import { standorte } from '../../data/standorte';
import { bild } from '../../lib/bilder';

const bilder: Record<string, { name: string; alt: string; fokus: string }> = {
  weyarn: { name: 'standorte/weyarn-front', alt: 'Glasfront des Motorradhauses in Weyarn mit Motorrädern davor', fokus: '42% 55%' },
  schongau: { name: 'standorte/schongau-front', alt: 'Das Stammhaus Erwin Martin in Schongau', fokus: '30% 50%' },
  'oy-mittelberg': { name: 'standorte/oy-front', alt: 'Der Neubau von BMW Martin in Oy-Mittelberg', fokus: '55% 50%' },
};
const reihenfolge = ['schongau', 'weyarn', 'oy-mittelberg'].map((slug) => standorte.find((s) => s.slug === slug)!);
---

<section class="hh" data-haeuser data-kopf="hell">
  <div class="wrap hh__kopf">
    <p class="hh__ober label">
      <span>BMW Motorrad Vertragshändler</span>
      <span class="dim">Familienbetrieb seit 1954</span>
    </p>
    <div class="hh__titel" data-hh-titel>
      <Fit tag="h1" lines={['Kein gewöhnlicher', 'BMW Partner.']} linesSm={['Kein', 'gewöhnlicher', 'BMW Partner.']} label="Kein gewöhnlicher BMW Partner." />
    </div>
  </div>

  <ul class="hh__saeulen wrap" role="list" data-lenis-prevent-touch>
    {
      reihenfolge.map((s, i) => (
        <li class="hh__saeule" data-hh-saeule={i}>
          <a class="hh__karte" href={`/standorte/${s.slug}/`}>
            <div class="hh__bild" data-hh-bild>
              <Bild src={bild(bilder[s.slug].name)} alt={bilder[s.slug].alt} sizes="(min-width: 900px) 34vw, 82vw" widths={[480, 800, 1200]} eager fokus={bilder[s.slug].fokus} />
            </div>
            <div class="hh__verlauf" aria-hidden="true" />
            <div class="hh__text">
              <span class="label hh__rolle">{s.rolle}</span>
              <span class="hh__name">{s.ort}</span>
              <span class="hh__fuss">
                <Status haus={s.slug} />
                <Pfeil />
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="wrap hh__unten">
    <p class="lead">Familienbetrieb seit 1954, heute in dritter Generation. Drei Häuser am Alpenrand – und eine eigene Manufaktur, in der aus BMW Motorrädern Einzelstücke werden.</p>
    <div class="hh__aktionen">
      <a class="btn btn--solid" href="/martin-edition/">Martin Edition ansehen <Pfeil /></a>
      <a class="btn" href="/kontakt/?anliegen=probefahrt">Probefahrt anfragen <Pfeil /></a>
    </div>
  </div>
</section>

<style>
  .hh {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    padding-bottom: clamp(3rem, 7vw, 6rem);
    overflow: clip;
  }
  .hh__kopf {
    padding-top: calc(var(--header-h) + clamp(0.5rem, 2vh, 1.5rem));
  }
  .hh__ober {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(0.5rem, 1.6vh, 1.1rem);
    border-bottom: 1px solid var(--ink);
  }
  .hh__titel {
    margin-top: clamp(0.6rem, 2vh, 1.4rem);
  }
  .hh__saeulen {
    display: flex;
    gap: var(--gap);
    margin-top: clamp(1.5rem, 3vh, 2.5rem);
    height: clamp(26rem, 64svh, 46rem);
  }
  .hh__saeule {
    flex: 1 1 0;
    min-width: 0;
    transition: flex-grow 0.8s var(--ease);
  }
  .hh__saeule:nth-child(2) {
    margin-top: clamp(2rem, 5vw, 5rem);
  }
  .hh__saeule:nth-child(3) {
    margin-top: clamp(1rem, 2.5vw, 2.5rem);
  }
  @media (hover: hover) and (min-width: 900px) {
    .hh__saeulen:hover .hh__saeule:hover {
      flex-grow: 1.55;
    }
  }
  .hh__karte {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--night);
    color: var(--chalk);
  }
  .hh__bild,
  .hh__bild :global(.bild) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hh__bild :global(img) {
    transition: transform 1.2s var(--ease);
  }
  .hh__karte:hover .hh__bild :global(img) {
    transform: scale(1.04);
  }
  .hh__verlauf {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(11 12 12 / 0.82), transparent 52%);
  }
  .hh__text {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 0.4rem;
    padding: clamp(1rem, 2vw, 1.75rem);
  }
  .hh__rolle {
    color: var(--chalk-2);
  }
  .hh__name {
    font-size: clamp(1.8rem, 1rem + 2.4vw, 3.6rem);
    font-weight: 800;
    font-stretch: 108%;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    transition: font-stretch 0.6s var(--ease);
  }
  .hh__karte:hover .hh__name {
    font-stretch: 122%;
  }
  .hh__fuss {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.35rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgb(236 233 226 / 0.35);
  }
  .hh__unten {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 1.5rem var(--gap);
    align-items: end;
    margin-top: clamp(2.5rem, 6vw, 6rem);
  }
  .hh__unten .lead {
    max-width: 30em;
  }
  .hh__aktionen {
    display: grid;
    gap: 0.5rem;
  }
  @media (max-width: 899px) {
    .hh__saeulen {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      height: 68svh;
      padding-inline: var(--pad);
      margin-inline: 0;
    }
    .hh__saeulen::-webkit-scrollbar {
      display: none;
    }
    .hh__saeule {
      flex: 0 0 80%;
      scroll-snap-align: center;
      margin-top: 0 !important;
    }
    .hh__unten {
      grid-template-columns: 1fr;
      margin-top: 2rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { bereit } from '../../scripts/bereit';

  function haeuser() {
    const sektion = document.querySelector<HTMLElement>('[data-haeuser]');
    if (!sektion) return;
    const mm = gsap.matchMedia();
    mm.add('(min-width: 900px) and (prefers-reduced-motion: no-preference)', () => {
      const st = { trigger: sektion, start: 'top top', end: 'bottom top', scrub: 0.5 };
      const tempo = [-14, -30, -20];
      const saeulen = Array.from(sektion.querySelectorAll<HTMLElement>('[data-hh-saeule]'));
      const anims: gsap.core.Tween[] = [];
      saeulen.forEach((s, i) => {
        anims.push(gsap.to(s, { yPercent: tempo[i], ease: 'none', scrollTrigger: st }));
        anims.push(gsap.fromTo(s.querySelector('[data-hh-bild]'), { scale: 1.16, yPercent: -4 }, { scale: 1.02, yPercent: 4, ease: 'none', scrollTrigger: st }));
      });
      // Schlagzeile teilt sich: obere Zeile nach links, untere nach rechts
      const zeilen = Array.from(sektion.querySelectorAll<HTMLElement>('[data-hh-titel] .fit__satz--lg .fit__mask'));
      zeilen.forEach((z, i) => {
        anims.push(gsap.to(z, { xPercent: i % 2 ? 9 : -9, ease: 'none', scrollTrigger: { ...st, end: '60% top' } }));
      });
      return () => anims.forEach((a) => a.scrollTrigger?.kill());
    });
    ScrollTrigger.refresh();
  }
  bereit(haeuser);
</script>
