<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { bereit } from '../scripts/bereit';

  /**
   * Das Tor: das Bildfenster im Auftakt öffnet sich beim Scrollen zur ganzen Bühne.
   * Das Bild liegt von Beginn an bildschirmfüllend vor und wird nur freigeschnitten –
   * es ruckelt nichts, weil sich allein clip-path und transform ändern.
   */
  function tor() {
    const sektion = document.querySelector<HTMLElement>('[data-tor]');
    if (!sektion) return;
    const platz = sektion.querySelector<HTMLElement>('[data-tor-platz]')!;
    const film = sektion.querySelector<HTMLElement>('[data-tor-film]')!;
    const bildEl = sektion.querySelector<HTMLElement>('[data-tor-bild]')!;
    const schleier = sektion.querySelector<HTMLElement>('[data-tor-schleier]')!;
    const etikett = sektion.querySelector<HTMLElement>('[data-tor-etikett]')!;

    const mm = gsap.matchMedia();
    mm.add('(min-width: 900px) and (min-height: 660px) and (prefers-reduced-motion: no-preference)', () => {
      sektion.classList.add('tor-aktiv');
      const r = { t: 0, r: 0, b: 0, l: 0, dx: 0, dy: 0, s: 1 };
      const miss = () => {
        const s = sektion.getBoundingClientRect();
        const p = platz.getBoundingClientRect();
        r.t = p.top - s.top;
        r.l = p.left - s.left;
        r.r = s.right - p.right;
        r.b = s.bottom - p.bottom;
        r.s = Math.max(p.width / s.width, p.height / s.height) * 1.03;
        r.dx = p.left + p.width / 2 - (s.left + s.width / 2);
        r.dy = p.top + p.height / 2 - (s.top + s.height / 2);
      };
      miss();
      const zu = () => `inset(${r.t}px ${r.r}px ${r.b}px ${r.l}px)`;

      const tl = gsap.timeline({
        defaults: { ease: 'power2.inOut' },
        scrollTrigger: {
          trigger: sektion,
          start: 'top top',
          end: '+=60%',
          pin: true,
          scrub: 0.5,
          refreshPriority: 10,
          invalidateOnRefresh: true,
          onRefreshInit: miss,
          onUpdate: (st) => {
            sektion.dataset.kopf = st.progress > 0.5 ? 'dunkel' : 'hell';
          },
        },
      });
      tl.fromTo(film, { clipPath: zu }, { clipPath: 'inset(0px 0px 0px 0px)', duration: 1 }, 0)
        .fromTo(bildEl, { x: () => r.dx, y: () => r.dy, scale: () => r.s }, { x: 0, y: 0, scale: 1, duration: 1 }, 0)
        .fromTo(schleier, { opacity: 0 }, { opacity: 1, duration: 0.5, ease: 'none' }, 0.45)
        .fromTo(etikett, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out' }, 0.72);

      return () => {
        sektion.classList.remove('tor-aktiv');
        sektion.dataset.kopf = 'hell';
        gsap.set([film, bildEl, schleier, etikett], { clearProps: 'all' });
      };
    });
    // Das Tor liegt vor allen anderen gepinnten Abschnitten – Reihenfolge neu ordnen
    ScrollTrigger.sort();
    ScrollTrigger.refresh();
  }
  bereit(tor);

</script>
