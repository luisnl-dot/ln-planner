  /* Schmale Bildschirme: Karte wird verschiebbar, die drei Häuser stehen im Bild, Schrift bleibt lesbar */
  @media (max-width: 760px) {
    .karte__fenster {
      overflow-x: auto;
      overscroll-behavior-x: contain;
