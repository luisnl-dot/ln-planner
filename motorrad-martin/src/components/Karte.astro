---
/**
 * Revierkarte: Oberbayern und Allgäu am Alpenrand mit den drei Häusern.
 * Landesgrenzen und Seen aus Natural Earth / geo-maps (src/data/karte-geo.json),
 * Flüsse, Straßen, Orte und Gipfel über bekannte Wegpunkte (src/data/karte-ebenen.ts).
 * Reines SVG, kein Kartendienst, keine Fremdanfrage.
 */
import geo from '../data/karte-geo.json';
import { alpenrand, autobahnen, bundesstrassen, fluesse, gewaesser, gipfel, orte, regionen, type LL } from '../data/karte-ebenen';
import { standorte } from '../data/standorte';

interface Props {
  /** Hervorgehobenes Haus (Standortseite). */
  aktiv?: string;
  class?: string;
  [key: `data-${string}`]: unknown;
}
const { aktiv, class: c, ...rest } = Astro.props;

const { breite: W, hoehe: H } = geo;
const [LNG0, LNG1, LAT0, LAT1] = geo.ausschnitt;
const x = (lng: number) => ((lng - LNG0) / (LNG1 - LNG0)) * W;
const y = (lat: number) => ((LAT1 - lat) / (LAT1 - LAT0)) * H;
const p = ([lat, lng]: LL): [number, number] => [x(lng), y(lat)];
const r1 = (n: number) => Math.round(n * 10) / 10;

/** Weiche Linie durch Punkte (Catmull-Rom → kubische Bézierkurven). */
function weich(pts: [number, number][], zu = false, t = 0.5): string {
  if (pts.length < 2) return '';
  const P = zu ? [pts[pts.length - 1], ...pts, pts[0], pts[1]] : [pts[0], ...pts, pts[pts.length - 1]];
  let d = `M${r1(P[1][0])} ${r1(P[1][1])}`;
  for (let i = 1; i < P.length - 2; i++) {
    const [p0, p1, p2, p3] = [P[i - 1], P[i], P[i + 1], P[i + 2]];
    const c1 = [p1[0] + ((p2[0] - p0[0]) / 6) * t * 2, p1[1] + ((p2[1] - p0[1]) / 6) * t * 2];
    const c2 = [p2[0] - ((p3[0] - p1[0]) / 6) * t * 2, p2[1] - ((p3[1] - p1[1]) / 6) * t * 2];
    d += ` C${r1(c1[0])} ${r1(c1[1])} ${r1(c2[0])} ${r1(c2[1])} ${r1(p2[0])} ${r1(p2[1])}`;
  }
  return d + (zu ? 'Z' : '');
}
const linie = (ll: LL[]) => weich(ll.map(p));

// Seen: nur sichtbare Flächen, weich gezeichnet
const flaeche = (q: number[][]) => Math.abs(q.reduce((a, [x1, y1], i) => { const [x2, y2] = q[(i + 1) % q.length]; return a + x1 * y2 - x2 * y1; }, 0) / 2);
const seen = (geo.seenPunkte as number[][][])
  .filter((q) => q.length > 2 && flaeche(q) > 20)
  .map((q) => weich((q[0][0] === q.at(-1)![0] && q[0][1] === q.at(-1)![1] ? q.slice(0, -1) : q) as [number, number][], true, 0.35));

// Alpen: Fläche südlich des Alpenrands
const rand = alpenrand.map(p);
const alpenFlaeche = `${weich(rand)} L${W + 20} ${H + 20} L-20 ${H + 20} Z`;

// Maßstab: 1° Breite ≈ 111,2 km
const pxProKm = H / ((LAT1 - LAT0) * 111.2);
const km20 = pxProKm * 20;

// Luftlinien zwischen den Häusern
const km = (a: { lat: number; lng: number }, b: { lat: number; lng: number }) => {
  const R = 6371;
  const r = (v: number) => (v * Math.PI) / 180;
  const h = Math.sin(r(b.lat - a.lat) / 2) ** 2 + Math.cos(r(a.lat)) * Math.cos(r(b.lat)) * Math.sin(r(b.lng - a.lng) / 2) ** 2;
  return Math.round(2 * R * Math.asin(Math.sqrt(h)));
};
const nachLng = [...standorte].sort((a, b) => a.karte.lng - b.karte.lng);
const strecken = nachLng.slice(0, -1).map((a, i) => {
  const b = nachLng[i + 1];
  const [ax, ay] = [x(a.karte.lng), y(a.karte.lat)];
  const [bx, by] = [x(b.karte.lng), y(b.karte.lat)];
  return { ax, ay, bx, by, km: km(a.karte, b.karte), mx: (ax + bx) / 2, my: (ay + by) / 2 };
});

// Beschriftung der Häuser
const etikett: Record<string, { dx: number; dy: number; a: 'start' | 'end' | 'middle' }> = {
  'oy-mittelberg': { dx: -16, dy: 0, a: 'end' },
  schongau: { dx: -16, dy: -2, a: 'end' },
  weyarn: { dx: 0, dy: -27, a: 'middle' },
};
const lage = { o: [0, -9, 'middle'], u: [0, 17, 'middle'], r: [8, 4, 'start'], l: [-8, 4, 'end'], or: [7, -6, 'start'], ol: [-7, -6, 'end'], ur: [7, 14, 'start'], ul: [-7, 14, 'end'] } as const;
---

<figure class:list={['karte', c]} data-karte data-aktiv={aktiv} {...rest}>
  <div class="karte__fenster" data-karte-fenster>
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="karte-titel karte-text" preserveAspectRatio="xMidYMid meet">
      <title id="karte-titel">Die drei Häuser von BMW Motorrad Martin in Oberbayern und im Allgäu</title>
      <desc id="karte-text">
        Karte zwischen Bodensee, München und Salzburg. Oy-Mittelberg liegt im Allgäu an der A7 südlich von Kempten, Schongau im Pfaffenwinkel an Lech und B17, Weyarn im Oberland direkt an der A8 zwischen München und Rosenheim.
      </desc>
      <defs>
        <pattern id="k-schraffur" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
          <line x1="0" y1="0" x2="0" y2="5" class="karte__schraffur"></line>
        </pattern>
        <linearGradient id="k-alpen" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0.35" class="karte__alpen-a"></stop>
          <stop offset="1" class="karte__alpen-b"></stop>
        </linearGradient>
        <clipPath id="k-rahmen"><rect width={W} height={H}></rect></clipPath>
      </defs>

      <g clip-path="url(#k-rahmen)">
        <rect width={W} height={H} class="karte__land"></rect>

        <!-- Gradnetz -->
        <g class="karte__netz" aria-hidden="true">
          {[10, 11, 12, 13].map((l) => <line x1={r1(x(l))} y1="0" x2={r1(x(l))} y2={H} />)}
          {[47.5, 48].map((l) => <line x1="0" y1={r1(y(l))} x2={W} y2={r1(y(l))} />)}
          {[10, 11, 12, 13].map((l) => <text x={r1(x(l)) + 4} y={H - 6} class="karte__grad">{l}° O</text>)}
          {[47.5, 48].map((l) => <text x="6" y={r1(y(l)) - 5} class="karte__grad">{String(l).replace('.', ',')}° N</text>)}
        </g>

        <!-- Alpen -->
        <g aria-hidden="true">
          <path d={alpenFlaeche} fill="url(#k-alpen)"></path>
          <path d={alpenFlaeche} fill="url(#k-schraffur)" class="karte__alpen-schraffur"></path>
          <path d={weich(rand)} class="karte__alpenrand"></path>
        </g>

        <!-- Gewässer -->
        <g class="karte__fluesse" aria-hidden="true">
          {fluesse.map((f) => <path d={linie(f.punkte)} class:list={['karte__fluss', ['Lech', 'Isar', 'Inn', 'Iller'].includes(f.name) && 'karte__fluss--gross']} />)}
        </g>
        <g class="karte__seen" aria-hidden="true">
          {seen.map((d) => <path d={d} />)}
        </g>

        <!-- Grenzen -->
        <g class="karte__grenzen" aria-hidden="true">
          {geo.grenzen.map((d) => <path d={d} />)}
        </g>

        <!-- Straßen -->
        <g aria-hidden="true">
          {bundesstrassen.map((b) => <path d={linie(b.punkte)} class="karte__b" />)}
          {autobahnen.map((a) => <path d={linie(a.punkte)} class="karte__a-rand" />)}
          {autobahnen.map((a) => <path d={linie(a.punkte)} class:list={['karte__a', a.ausland && 'karte__a--ausland']} />)}
        </g>

        <!-- Gipfel -->
        <g class="karte__gipfel" aria-hidden="true">
          {
            gipfel.map((g) => {
              const [gx, gy] = p(g.ll);
              return (
                <g>
                  <path d={`M${r1(gx)} ${r1(gy - 5)} l4.5 7.5 h-9 Z`} />
                  <text x={r1(gx)} y={r1(gy + 13)} text-anchor="middle">
                    {g.n} <tspan class="karte__hoehe">{g.m.toLocaleString('de-DE')}</tspan>
                  </text>
                </g>
              );
            })
          }
        </g>

        <!-- Landschaften und Länder -->
        <g aria-hidden="true">
          {
            regionen.map((rg) => {
              const [rx, ry] = p(rg.ll);
              return (
                <text x={r1(rx)} y={r1(ry)} text-anchor="middle" class:list={['karte__region', rg.gross && 'karte__region--land']}>
                  {rg.n}
                </text>
              );
            })
          }
          {
            gewaesser.map((g) => {
              const [gx, gy] = p(g.ll);
              return (
                <text x={r1(gx)} y={r1(gy)} text-anchor={g.a ?? 'middle'} class:list={['karte__wasser', g.gross && 'karte__wasser--gross']}>
                  {g.n}
                </text>
              );
            })
          }
          {
            fluesse
              .filter((f) => f.label)
              .map((f) => {
                const [fx, fy] = p(f.label!.at);
                return (
                  <text x={r1(fx)} y={r1(fy)} text-anchor="middle" class="karte__wasser karte__wasser--fluss" transform={`rotate(${f.label!.winkel ?? 0} ${r1(fx)} ${r1(fy)})`}>
                    {f.name}
                  </text>
                );
              })
          }
        </g>

        <!-- Straßenschilder -->
        <g aria-hidden="true">
          {
            bundesstrassen.map((b) => {
              const [sx, sy] = p(b.schild);
              const w = b.nr.length * 7.2 + 8;
              return (
                <g class="karte__schild karte__schild--b" transform={`translate(${r1(sx)} ${r1(sy)})`}>
                  <rect x={-w / 2} y="-7.5" width={w} height="15" rx="2" />
                  <text y="4" text-anchor="middle">{b.nr}</text>
                </g>
              );
            })
          }
          {
            autobahnen.map((a) => {
              const [sx, sy] = p(a.schild);
              const w = a.nr.length * 7.6 + 9;
              return (
                <g class:list={['karte__schild karte__schild--a', a.ausland && 'karte__schild--ausland']} transform={`translate(${r1(sx)} ${r1(sy)})`}>
                  <rect x={-w / 2} y="-8" width={w} height="16" rx="3" />
                  <text y="4.2" text-anchor="middle">{a.nr}</text>
                </g>
              );
            })
          }
        </g>

        <!-- Orte -->
        <g aria-hidden="true">
          {
            orte.map((o) => {
              const [ox, oy] = p(o.ll);
              const [dx, dy, an] = lage[o.lage ?? 'r'];
              return (
                <g class:list={['karte__ort', o.gross && 'karte__ort--gross', o.ausland && 'karte__ort--ausland', o.mobil && 'karte__ort--mobil']} data-ort={o.n}>
                  {o.gross ? <rect x={r1(ox) - 4} y={r1(oy) - 4} width="8" height="8" /> : <circle cx={r1(ox)} cy={r1(oy)} r="2.6" />}
                  <text x={r1(ox) + dx * (o.gross ? 1.3 : 1)} y={r1(oy) + dy * (o.gross ? 1.15 : 1)} text-anchor={an}>
                    {o.n}
                  </text>
                </g>
              );
            })
          }
        </g>

        <!-- Luftlinien -->
        <g aria-hidden="true" class="karte__strecken">
          {strecken.map((st) => <line x1={r1(st.ax)} y1={r1(st.ay)} x2={r1(st.bx)} y2={r1(st.by)} class="karte__luftlinie" />)}
        </g>

        <!-- Häuser -->
        {
          standorte.map((s) => {
            const [hx, hy] = [x(s.karte.lng), y(s.karte.lat)];
            const e = etikett[s.slug];
            const breite = s.ort.length * 9.6 + 22;
            const bx = e.a === 'start' ? hx + e.dx : e.a === 'end' ? hx + e.dx - breite : hx - breite / 2;
            const by = hy + e.dy - 13;
            return (
              <a href={`/standorte/${s.slug}/`} class="karte__haus" data-karte-haus={s.slug} data-einzug={s.einzugsgebiet.join('|')} aria-label={`${s.name}, ${s.strasse}, ${s.plz} ${s.ort}`}>
                <circle class="karte__ring" cx={r1(hx)} cy={r1(hy)} r="17" />
                <circle class="karte__punkt" cx={r1(hx)} cy={r1(hy)} r="8" />
                <circle class="karte__kern" cx={r1(hx)} cy={r1(hy)} r="2.8" />
                <g class="karte__etikett">
                  <rect x={r1(bx)} y={r1(by)} width={r1(breite)} height="26" rx="13" />
                  <text x={r1(e.a === 'end' ? bx + breite - 11 : e.a === 'start' ? bx + 11 : bx + breite / 2)} y={r1(by + 17.5)} text-anchor={e.a} class="karte__name">{s.ort}</text>
                </g>
              </a>
            );
          })
        }

        <!-- Maßstab und Nordpfeil -->
        <g aria-hidden="true" transform={`translate(${W - km20 - 34} ${H - 30})`} class="karte__massstab">
          <rect x="0" y="0" width={r1(km20 / 2)} height="5" class="karte__massstab-a" />
          <rect x={r1(km20 / 2)} y="0" width={r1(km20 / 2)} height="5" class="karte__massstab-b" />
          <text x="0" y="-6">0</text>
          <text x={r1(km20)} y="-6" text-anchor="middle">20 km</text>
        </g>
        <g aria-hidden="true" transform={`translate(${W - 24} 34)`} class="karte__nord">
          <path d="M0 -16 L6 6 L0 2 L-6 6 Z" />
          <text y="20" text-anchor="middle">N</text>
        </g>
      </g>
      <rect width={W} height={H} class="karte__rahmen"></rect>
    </svg>
  </div>
  <figcaption class="karte__legende">
    <ul role="list">
      <li><span class="karte__l karte__l--haus" aria-hidden="true"></span>Martin</li>
      <li><span class="karte__l karte__l--a" aria-hidden="true"></span>Autobahn</li>
      <li><span class="karte__l karte__l--b" aria-hidden="true"></span>Bundesstraße</li>
      <li><span class="karte__l karte__l--grenze" aria-hidden="true"></span>Staatsgrenze</li>
      <li><span class="karte__l karte__l--alpen" aria-hidden="true"></span>Alpen</li>
    </ul>
    <p>
      Luftlinie {strecken.map((st, i) => <span>{i > 0 && ' · '}{nachLng[i].ort} – {nachLng[i + 1].ort} {st.km} km</span>)}
      <br />Grenzen und Seen nach Natural Earth · Straßen und Flüsse vereinfacht
    </p>
  </figcaption>
</figure>

<style is:global>
  .karte {
    --k-land: #f4f1ea;
    --k-netz: rgb(14 15 15 / 0.07);
    --k-wasser: #c8d6df;
    --k-wasser-rand: #8ea8ba;
    --k-wasser-text: #4f7189;
    --k-alpen-a: rgb(70 76 72 / 0);
    --k-alpen-b: rgb(70 76 72 / 0.16);
    --k-a: #2b2e2d;
    --k-b: #8b8d89;
    --k-text: #1d1f1e;
    --k-text-2: #555955;
    --k-blau: #1f4f9c;
    --k-gelb: #f2c230;
    position: relative;
    margin: 0;
  }
  .karte__fenster {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: var(--k-land);
  }
  .karte svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font);
  }
  .karte__land {
    fill: var(--k-land);
  }
  .karte__rahmen {
    fill: none;
  }
  .karte__netz line {
    stroke: var(--k-netz);
    stroke-width: 1;
  }
  .karte__grad {
    font-size: 9px;
    fill: var(--k-text-2);
    opacity: 0.55;
    letter-spacing: 0.04em;
  }
  .karte__alpen-a {
    stop-color: var(--k-alpen-a);
  }
  .karte__alpen-b {
    stop-color: var(--k-alpen-b);
  }
  .karte__schraffur {
    stroke: #3e433f;
    stroke-width: 0.6;
  }
  .karte__alpen-schraffur {
    opacity: 0.14;
  }
  .karte__alpenrand {
    fill: none;
    stroke: rgb(62 67 63 / 0.35);
    stroke-width: 0.8;
    stroke-dasharray: 1 3;
  }
  .karte__fluss {
    fill: none;
    stroke: var(--k-wasser-rand);
    stroke-width: 0.9;
    stroke-linecap: round;
  }
  .karte__fluss--gross {
    stroke-width: 1.5;
  }
  .karte__seen path {
    fill: var(--k-wasser);
    stroke: var(--k-wasser-rand);
    stroke-width: 0.6;
  }
  .karte__grenzen path {
    fill: none;
    stroke: #5b5f5b;
    stroke-width: 1.3;
    stroke-dasharray: 7 3 1.5 3;
  }
  .karte__b {
    fill: none;
    stroke: var(--k-b);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .karte__a-rand {
    fill: none;
    stroke: var(--k-land);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .karte__a {
    fill: none;
    stroke: var(--k-a);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .karte__a--ausland {
    stroke: #6d706c;
    stroke-width: 1.8;
  }
  .karte__schild text {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .karte__schild--a rect {
    fill: var(--k-blau);
    stroke: #fff;
    stroke-width: 1.2;
  }
  .karte__schild--a text {
    fill: #fff;
  }
  .karte__schild--ausland rect {
    fill: #fff;
    stroke: #6d706c;
  }
  .karte__schild--ausland text {
    fill: #3c3f3c;
  }
  .karte__schild--b rect {
    fill: var(--k-gelb);
    stroke: #1d1f1e;
    stroke-width: 0.8;
  }
  .karte__schild--b text {
    fill: #1d1f1e;
  }
  .karte__gipfel path {
    fill: #4a4f4b;
  }
  .karte__gipfel text {
    font-size: 9.5px;
    fill: #3c403d;
    letter-spacing: 0.01em;
  }
  .karte__hoehe {
    fill: #7a7e7a;
  }
  .karte__region {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    fill: #9a9c97;
  }
  .karte__region--land {
    font-size: 15px;
    letter-spacing: 0.6em;
    fill: #a9aaa5;
  }
  .karte__wasser {
    font-size: 10px;
    fill: var(--k-wasser-text);
    letter-spacing: 0.06em;
  }
  .karte__wasser--gross {
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .karte__wasser--fluss {
    font-size: 9.5px;
    letter-spacing: 0.16em;
  }
  .karte__ort circle,
  .karte__ort rect {
    fill: var(--k-land);
    stroke: var(--k-text);
    stroke-width: 1.3;
  }
  .karte__ort text {
    font-size: 11.5px;
    fill: var(--k-text);
    paint-order: stroke;
    stroke: var(--k-land);
    stroke-width: 3.5px;
    stroke-linejoin: round;
  }
  .karte__ort--gross rect {
    fill: var(--k-text);
  }
  .karte__ort--gross text {
    font-size: 14px;
    font-weight: 650;
    letter-spacing: 0.02em;
  }
  .karte__ort--ausland text {
    fill: var(--k-text-2);
  }
  .karte__ort {
    transition: opacity 0.35s;
  }
  .karte.hat-fokus .karte__ort:not(.ist-nah):not(.karte__ort--gross) {
    opacity: 0.4;
  }
  .karte__ort.ist-nah circle {
    fill: var(--k-text);
  }
  .karte__ort.ist-nah text {
    font-weight: 650;
  }
  .karte__luftlinie {
    stroke: var(--k-text);
    stroke-width: 1;
    stroke-dasharray: 1.5 4.5;
    stroke-linecap: round;
    opacity: 0.45;
  }
  .karte__haus {
    cursor: pointer;
  }
  .karte__ring {
    fill: none;
    stroke: var(--k-text);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    animation: karte-puls 3.4s var(--ease) infinite;
  }
  .karte__haus:nth-of-type(2) .karte__ring {
    animation-delay: 0.6s;
  }
  .karte__haus:nth-of-type(3) .karte__ring {
    animation-delay: 1.2s;
  }
  @keyframes karte-puls {
    0% {
      transform: scale(0.45);
      opacity: 0.8;
    }
    80%,
    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }
  .karte__punkt {
    fill: var(--k-text);
    stroke: var(--k-land);
    stroke-width: 2.5;
    transition: r 0.35s var(--ease);
  }
  .karte__kern {
    fill: var(--k-land);
  }
  .karte__etikett rect {
    fill: var(--k-text);
    transition: fill 0.3s;
  }
  .karte__name {
    font-size: 14.5px;
    font-weight: 650;
    letter-spacing: 0.01em;
    fill: #f4f1ea;
  }
  .karte__haus:hover .karte__etikett rect,
  .karte__haus:focus-visible .karte__etikett rect,
  .karte__haus.ist-aktiv .karte__etikett rect {
    fill: var(--k-blau);
  }
  .karte__haus:hover .karte__punkt,
  .karte__haus:focus-visible .karte__punkt,
  .karte__haus.ist-aktiv .karte__punkt {
    r: 9.5px;
  }
  .karte__haus:focus-visible {
    outline: none;
  }
  .karte__haus:focus-visible .karte__etikett rect {
    stroke: var(--k-gelb);
    stroke-width: 2;
  }
  .karte__massstab rect {
    stroke: var(--k-text);
    stroke-width: 0.8;
  }
  .karte__massstab-a {
    fill: var(--k-text);
  }
  .karte__massstab-b {
    fill: var(--k-land);
  }
  .karte__massstab text,
  .karte__nord text {
    font-size: 9.5px;
    fill: var(--k-text);
    letter-spacing: 0.04em;
  }
  .karte__nord path {
    fill: var(--k-text);
  }

  /* Legende */
  .karte__legende {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    color: var(--fg-2);
  }
  .karte__legende ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
