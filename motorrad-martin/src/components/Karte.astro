  .karte__l--alpen {
    background: repeating-linear-gradient(-55deg, rgb(62 67 63 / 0.45) 0 1px, transparent 1px 4px), rgb(70 76 72 / 0.08);
  }

  /* Zeichnen beim Einblenden */
  .js .karte[data-reveal] .karte__haus {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.7s var(--ease) 0.5s,
      transform 0.9s var(--ease) 0.5s;
