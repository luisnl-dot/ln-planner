    border-radius: 50%;
    background: var(--k-text);
    box-shadow: 0 0 0 2px var(--k-land), 0 0 0 3px var(--k-text);
  }
  .karte__l--a {
    background: linear-gradient(var(--k-a), var(--k-a)) center / 100% 2.5px no-repeat;
