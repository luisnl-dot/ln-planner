---
/**
 * Typenschild-Satz: jede Zeile wird per Skript (scripts/fit.ts) über Schriftgröße und
 * Breitenachse bündig auf die Spaltenbreite gesetzt. Ohne JavaScript bleibt ein
 * normaler, umbrechender Titel stehen.
 */
interface Props {
  lines: string[];
  /** Alternative Zeilenaufteilung für schmale Viewports. */
  linesSm?: string[];
  tag?: 'h1' | 'h2' | 'h3' | 'p' | 'div';
  class?: string;
  /** Vorlesetext, falls er von den Zeilen abweichen soll. */
  label?: string;
  /** Lange Zeilen für schmale Viewports automatisch an Wortgrenzen teilen. */
  auto?: boolean;
  /** So viele Zeilen am Ende tragen die Akzentfarbe (Desktop-Satz). */
  akzent?: number;
  /** … und im schmalen Satz. */
  akzentSm?: number;
  id?: string;
}
const { lines, tag: Tag = 'h2', class: c, label, auto = false, akzent = 0, akzentSm = 0, id } = Astro.props;
const text = label ?? lines.join(' ');

/** Teilt eine Zeile in Stücke von höchstens `max` Zeichen (an Leerzeichen, nach Bindestrichen). */
export function teile(zeile: string, max = 11): string[] {
  const worte = zeile.split(/\s+/).flatMap((w) => (w.length > max && w.includes('-') ? w.split(/(?<=-)/) : [w]));
  const aus: string[] = [];
  for (const w of worte) {
    const letzte = aus[aus.length - 1];
    const naht = letzte?.endsWith('-') ? '' : ' ';
    if (letzte !== undefined && (letzte + naht + w).length <= max) aus[aus.length - 1] = letzte + naht + w;
    else aus.push(w);
  }
  return aus;
}
const geteilt = auto ? lines.flatMap((l) => teile(l)) : undefined;
const linesSm = Astro.props.linesSm ?? (geteilt && geteilt.length > lines.length ? geteilt : undefined);
---

<Tag class:list={['fit', c]} data-fit="" id={id}>
  <span class="sr-only">{text}</span>
  <span class:list={['fit__satz', linesSm && 'fit__satz--lg']} aria-hidden="true">
    {
      lines.map((l, i) => (
        <span class="fit__mask">
          <span class:list={['fit__line', i >= lines.length - akzent && 'fit__line--akzent']} style={`--i:${i}`}>
            {l}
          </span>
        </span>
      ))
    }
  </span>
  {
    linesSm && (
      <span class="fit__satz fit__satz--sm" aria-hidden="true">
        {linesSm.map((l, i) => (
          <span class="fit__mask">
            <span class:list={['fit__line', i >= linesSm.length - akzentSm && 'fit__line--akzent']} style={`--i:${i}`}>
              {l}
            </span>
          </span>
        ))}
      </span>
    )
  }
</Tag>

<style is:global>
  .fit__satz {
    display: block;
  }
  @media (max-width: 719px) {
    .fit__satz--lg {
      display: none;
    }
  }
  @media (min-width: 720px) {
    .fit__satz--sm {
      display: none;
    }
  }
  .fit__line--akzent {
    color: var(--edition, var(--accent));
  }
  .fit__line {
    padding-top: 0.17em;
    margin-top: -0.12em;
    padding-bottom: 0.03em;
  }
  .js .fit .fit__line {
    transform: translate3d(0, 108%, 0);
    transition: transform 1.25s var(--ease);
    transition-delay: calc(var(--i, 0) * 95ms + var(--verzug, 0ms));
  }
  .js .fit.is-in .fit__line {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .js .fit .fit__line {
      transform: none;
    }
  }
</style>
