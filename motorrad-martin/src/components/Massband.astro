---
/**
 * Maßband: die Firmengeschichte als Skala von 1954 bis heute.
 * Jeder Teilstrich ist ein Jahr, die Stationen sind beschriftet.
 */
import { chronik } from '../data/chronik';
const von = 1954;
const bis = new Date().getFullYear();
const jahre = Array.from({ length: bis - von + 1 }, (_, i) => von + i);
const stationen = new Map(chronik.map((c) => [Number(c.jahr), c]));
---

<div class="massband" data-reveal>
  <ol class="massband__skala" role="list" style={`--n:${jahre.length}`}>
    {
      jahre.map((j) => {
        const s = stationen.get(j);
        return s ? (
          <li class="massband__jahr ist-station" style={`--hoch:${[1954, 1967, 1998, 2018].includes(j) ? 1 : 0}`}>
            <span class="massband__zahl">{j}</span>
            <span class="massband__text">
              <strong>{s.titel}</strong>
              <span>{s.text}</span>
            </span>
          </li>
        ) : (
          <li class:list={['massband__jahr', j % 10 === 0 && 'ist-zehner']} aria-hidden="true" />
        );
      })
    }
  </ol>
  <div class="massband__enden label label--dim" aria-hidden="true">
    <span>{von}</span>
    <span>{bis - von} Jahre</span>
    <span>{bis}</span>
  </div>
</div>

<style is:global>
  .massband {
    position: relative;
  }
  .massband__skala {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    align-items: end;
    height: clamp(11rem, 20vw, 15rem);
    padding: 0;
    margin: 0;
    list-style: none;
    border-bottom: 1px solid var(--fg);
  }
  .massband__jahr {
    position: relative;
    height: 0.7rem;
    border-left: 1px solid var(--line-2);
  }
  .massband__jahr.ist-zehner {
    height: 1.2rem;
    border-left-color: var(--fg-2);
  }
  .massband__jahr.ist-station {
    height: calc(2.4rem + var(--hoch) * 3.4rem);
    border-left: 1.5px solid var(--fg);
  }
  .massband__zahl {
    position: absolute;
    left: 0.4rem;
    top: -0.35rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    white-space: nowrap;
  }
  .massband__text {
    position: absolute;
    left: 0.4rem;
    bottom: calc(100% + 0.9rem);
    width: max-content;
    max-width: 14rem;
    display: grid;
    gap: 0.25rem;
    font-size: 0.86rem;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(0.4rem);
    transition:
      opacity 0.35s,
      transform 0.5s var(--ease);
    pointer-events: none;
  }
  .massband__text strong {
    font-weight: 650;
    font-size: 1rem;
  }
  .massband__text span {
    color: var(--fg-2);
  }
  .massband__jahr.ist-station::after {
    content: '';
    position: absolute;
    left: -0.6rem;
    right: -0.6rem;
    top: -1rem;
    bottom: 0;
  }
  .massband__jahr.ist-station:hover .massband__text,
  .massband__jahr.ist-station:first-of-type .massband__text {
    opacity: 1;
    transform: none;
  }
  .massband__skala:hover .massband__jahr.ist-station:first-of-type:not(:hover) .massband__text {
    opacity: 0;
  }
  .massband__jahr.ist-station:nth-last-child(-n + 12) .massband__text {
    left: auto;
    right: 0.4rem;
    text-align: right;
  }
  .massband__enden {
    display: flex;
    justify-content: space-between;
    padding-top: 0.6rem;
  }
  @media (max-width: 899px) {
    /* mobil: Liste statt Skala */
    .massband__skala {
      display: block;
      height: auto;
      border-bottom: 0;
      border-top: 1px solid var(--fg);
    }
    .massband__jahr:not(.ist-station) {
      display: none;
    }
    .massband__jahr.ist-station {
      height: auto;
      border-left: 0;
      border-bottom: 1px solid var(--line);
      display: grid;
      grid-template-columns: 4.2rem 1fr;
      gap: 1rem;
      padding: 0.9rem 0;
    }
    .massband__jahr.ist-station::after {
      display: none;
    }
    .massband__zahl,
    .massband__text {
      position: static;
      opacity: 1 !important;
      transform: none;
      max-width: none;
      width: auto;
      text-align: left !important;
    }
    .massband__zahl {
      font-size: 0.86rem;
      padding-top: 0.2rem;
    }
    .massband__enden {
      display: none;
    }
  }
</style>
