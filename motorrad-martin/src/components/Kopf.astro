---
interface Props {
  nr?: string;
  label: string;
  titel?: string;
  tag?: 'h1' | 'h2' | 'h3';
  rechts?: string;
}
const { label, titel, tag: Tag = 'h2', rechts } = Astro.props;
---

<div class="kopf">
  <div class="kopf__nr label">
    <span>{label}</span>
    {rechts && <span class="dim">{rechts}</span>}
  </div>
  {
    (titel || Astro.slots.has('default')) && (
      <Tag class="kopf__titel h2" data-reveal>
        {titel}
        <slot />
      </Tag>
    )
  }
  {
    Astro.slots.has('seite') && (
      <div class="kopf__seite" data-reveal style="--i:1">
        <slot name="seite" />
      </div>
    )
  }
</div>
