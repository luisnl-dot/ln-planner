---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Anfrage from '../../components/Anfrage.astro';
import Bild from '../../components/Bild.astro';
import Fit, { teile } from '../../components/Fit.astro';
import JournalKarte from '../../components/JournalKarte.astro';
import Kopf from '../../components/Kopf.astro';
import Pfeil from '../../components/Pfeil.astro';
import Schild from '../../components/Schild.astro';
import { editionen, type EditionMitNr } from '../../data/editionen';
import { bild } from '../../lib/bilder';

export function getStaticPaths() {
  return editionen.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props as { e: EditionMitNr };

const i = editionen.indexOf(e);
const davor = editionen[(i - 1 + editionen.length) % editionen.length];
const danach = editionen[(i + 1) % editionen.length];
const journal = e.journal ? (await getCollection('journal')).find((j) => j.id === e.journal) : undefined;

const b1 = bild(`editionen/${e.slug}-1`);
const b2 = e.bilder === 2 ? bild(`editionen/${e.slug}-2`) : undefined;
const beschreibung = `${e.titel}: ${e.zeile} ${e.teile.length ? `Mit ${e.teile.slice(0, 3).join(', ')}.` : ''} Veredelt in der Manufaktur von BMW Motorrad Martin in Weyarn.`.replace(/\s+/g, ' ');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Motorcycle',
    name: e.titel,
    brand: { '@type': 'Brand', name: 'BMW Motorrad' },
    model: e.basis,
    vehicleConfiguration: `Martin Edition ${e.name}`,
    description: beschreibung,
    image: new URL(b1.src, Astro.site).href,
    url: new URL(`/martin-edition/${e.slug}/`, Astro.site).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Martin Edition', item: new URL('/martin-edition/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: `${e.basis} ${e.name}`, item: new URL(`/martin-edition/${e.slug}/`, Astro.site).href },
    ],
  },
];
---

<Basis titel={`${e.titel}`} beschreibung={beschreibung} dunkel akzent={e.akzent} bildOg={b1} schema={schema}>
  <article>
    <!-- ============ Bühne ============ -->
    <header class="ed-kopf">
      <div class="ed-kopf__bild">
        <Bild src={b1} alt={e.titel} sizes="100vw" eager vt={`ed-${e.slug}`} />
        <div class="ed-kopf__schleier" aria-hidden="true"></div>
      </div>
      <div class="ed-kopf__text wrap">
        <div class="ed-kopf__leiste label">
          <nav aria-label="Brotkrumen">
            <ol role="list" class="ed-kopf__krumen">
              <li><a href="/">Start</a></li>
              <li><a href="/martin-edition/">Martin Edition</a></li>
              <li><span aria-current="page">Katalog Nº {e.nr}</span></li>
            </ol>
          </nav>
          <span>{e.nr} / {String(editionen.length).padStart(2, '0')}</span>
        </div>
        <div class="ed-kopf__titelzeile">
          <Fit tag="h1" class="ed-kopf__titel" lines={[e.basis, e.name]} linesSm={[...teile(e.basis), ...teile(e.name)]} akzent={1} akzentSm={teile(e.name).length} label={e.titel} />
          <p class="ed-kopf__zeile muted" data-reveal style="--i:1">
            <span class="ed-kopf__farbe" aria-hidden="true"></span>Martin Edition · Katalog Nº {e.nr}
          </p>
        </div>
      </div>
    </header>

    <!-- ============ Charakter ============ -->
    <section class="section">
      <div class="wrap ed-intro">
        <div class="ed-intro__text">
          <p class="h2" data-reveal set:html={e.zeile.replace(/ (\S{1,3}) /g, ' $1&nbsp;').replace(/ R (\d)/g, ' R&nbsp;$1')} />
          {
            e.text ? (
              <div class="prosa mt3">
                {e.text.map((p, n) => (
                  <p data-reveal style={`--i:${n}`}>
                    {p}
                  </p>
                ))}
              </div>
            ) : (
              <p class="lead muted mt3 measure" data-reveal style="--i:1">
                Auf Basis der BMW {e.basis} in unserer Manufaktur in Weyarn veredelt – in Handarbeit, streng limitiert, jedes ein Einzelstück.
              </p>
            )
          }
        </div>
        <aside class="ed-intro__seite" data-reveal style="--i:1">
          <Schild
            zeilen={[
              ['Basis', `BMW ${e.basis}`],
              ['Edition', e.name],
              ['Baureihe', e.familie],
              ['Katalog', `Nº ${e.nr} / ${editionen.length}`],
              ['Manufaktur', 'Weyarn'],
            ]}
          />
          <a class="btn btn--solid btn--block mt2" href="#anfrage">Diese Edition anfragen <Pfeil /></a>
          <a class="btn btn--block" style="margin-top:.5rem" href={`/kontakt/?anliegen=probefahrt&fahrzeug=${encodeURIComponent('BMW ' + e.basis)}`}>BMW {e.basis} Probe fahren <Pfeil /></a>
        </aside>
      </div>
    </section>

    <!-- ============ Stückliste ============ -->
    {
      e.teile.length > 0 && (
        <section class="section section--flush-top">
          <div class="wrap">
            <Kopf nr="01" label="Stückliste" rechts={`${e.teile.length} dokumentierte Komponenten`} />
            <ol class="stueck" role="list">
              {e.teile.map((t, n) => (
                <li data-reveal style={`--i:${Math.min(n, 6)}`}>
                  <span class="mono ed-akzent">{String(n + 1).padStart(2, '0')}</span>
                  <span class="stueck__teil">{t}</span>
                </li>
              ))}
            </ol>
            <p class="label label--dim mt2">Dokumentierte Komponenten dieser Edition · Ausstattung und Verfügbarkeit auf Anfrage</p>
          </div>
        </section>
      )
    }

    <!-- ============ Zweite Ansicht ============ -->
    {
      b2 && (
        <figure class="ed-zwei wrap">
          <Bild src={b2} alt={`${e.titel} – zweite Ansicht`} sizes="100vw" ratio="32" reveal />
          <figcaption class="bild__unterschrift label">
            <span>BMW {e.basis} · Martin Edition {e.name}</span>
            <span>Foto: Darren Jacklin</span>
          </figcaption>
        </figure>
      )
    }

    <!-- ============ Journal ============ -->
    {
      journal && (
        <section class="section">
          <div class="wrap">
            <Kopf nr="02" label="Aus dem Journal" />
            <div class="ed-journal">
              <JournalKarte eintrag={journal} gross sizes="(min-width: 1000px) 58vw, 100vw" />
            </div>
          </div>
        </section>
      )
    }

    <!-- ============ Anfrage ============ -->
    <section class="section ed-anfrage" id="anfrage">
      <div class="wrap ed-anfrage__raster">
        <div>
          <p class="label label--dim">Anfrage</p>
          <h2 class="h1 h1--s mt2" data-reveal>
            {e.name}<br /><span class="ed-akzent">für Sie.</span>
          </h2>
          <p class="lead muted mt2 measure-s" data-reveal style="--i:1">Fragen Sie Verfügbarkeit, Ausstattung und Preis dieser Edition an – oder lassen Sie sich Ihre eigene bauen.</p>
        </div>
        <Anfrage anliegen="edition" haus="weyarn" fahrzeug={e.titel} nachrichtLabel="Ihre Nachricht" knopf="Edition anfragen" />
      </div>
    </section>

    <!-- ============ Weiter ============ -->
    <nav class="ed-weiter" aria-label="Weitere Editionen">
      <a class="ed-weiter__link" href={`/martin-edition/${davor.slug}/`} style={`--edition:${davor.akzent}`}>
        <span class="label label--dim">← Nº {davor.nr}</span>
        <span class="ed-weiter__name">{davor.basis} {davor.name}</span>
      </a>
      <a class="ed-weiter__mitte label" href="/martin-edition/">Alle {editionen.length} Editionen</a>
      <a class="ed-weiter__link ed-weiter__link--r" href={`/martin-edition/${danach.slug}/`} style={`--edition:${danach.akzent}`}>
        <span class="label label--dim">Nº {danach.nr} →</span>
        <span class="ed-weiter__name">{danach.basis} {danach.name}</span>
      </a>
    </nav>
  </article>
</Basis>

<style>
  .ed-akzent {
    color: var(--edition);
  }
  .ed-kopf {
    background: var(--night);
    color: var(--fg);
  }
  .ed-kopf__bild {
    position: relative;
    height: clamp(20rem, 78svh, 58vw);
    overflow: hidden;
  }
  .ed-kopf__bild :global(.bild) {
    width: 100%;
    height: 100%;
  }
  .ed-kopf__schleier {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(11 12 12 / 0.62), transparent 24%), linear-gradient(to top, rgb(11 12 12 / 0.55), transparent 18%);
    pointer-events: none;
  }
  .ed-kopf__text {
    padding-top: clamp(0.9rem, 1.6vw, 1.4rem);
  }
  .ed-kopf__leiste {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--fg);
  }
  .ed-kopf__krumen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
  }
  .ed-kopf__krumen li + li::before {
    content: '/';
    margin-right: 0.6rem;
    opacity: 0.6;
  }
  .ed-kopf__krumen a {
    opacity: 0.72;
  }
  .ed-kopf__krumen a:hover {
    opacity: 1;
  }
  .ed-kopf__titelzeile {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 2rem;
    align-items: end;
    padding-top: clamp(0.9rem, 2vw, 1.5rem);
    padding-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .ed-kopf__zeile {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ed-kopf__farbe {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--edition);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.2);
  }
  @media (max-width: 700px) {
    .ed-kopf__titelzeile {
      grid-template-columns: 1fr;
    }
  }
  .ed-intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 3rem clamp(2rem, 7vw, 8rem);
    align-items: start;
  }
  .ed-intro__text .h2 {
    max-width: 20ch;
  }
  .ed-intro__seite {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }
  @media (max-width: 1000px) {
    .ed-intro {
      grid-template-columns: 1fr;
    }
    .ed-intro__seite {
      position: static;
      max-width: 30rem;
    }
  }

  .stueck {
    columns: 2;
    column-gap: var(--gap);
    border-top: 1px solid var(--fg);
  }
  .stueck li {
    break-inside: avoid;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .stueck__teil {
    font-size: clamp(1.1rem, 0.95rem + 0.7vw, 1.6rem);
    font-weight: 560;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  @media (max-width: 800px) {
    .stueck {
      columns: 1;
    }
  }

  .ed-zwei {
    padding-bottom: var(--section);
  }
  .ed-journal {
    max-width: 62rem;
  }

  .ed-anfrage {
    background: var(--night-2);
    --bg: var(--night-2);
  }
  .ed-anfrage__raster {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 3rem clamp(2rem, 6vw, 7rem);
    align-items: start;
  }
  @media (max-width: 1000px) {
    .ed-anfrage__raster {
      grid-template-columns: 1fr;
    }
  }

  .ed-weiter {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    border-top: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
  }
  .ed-weiter__link {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.5rem, 4vw, 3.5rem) var(--pad);
    transition: background 0.4s;
  }
  .ed-weiter__link--r {
    text-align: right;
    justify-items: end;
  }
  .ed-weiter__link:hover {
    background: var(--bg-2);
  }
  .ed-weiter__name {
    font-size: clamp(1.2rem, 0.8rem + 1.8vw, 2.4rem);
    font-weight: 760;
    font-stretch: 100%;
    letter-spacing: -0.025em;
    line-height: 1;
    transition: font-stretch 0.6s var(--ease),
      color 0.3s;
    text-transform: uppercase;
  }
  .ed-weiter__link:hover .ed-weiter__name {
    color: var(--edition);
    font-stretch: 116%;
  }
  .ed-weiter__mitte {
    display: grid;
    place-items: center;
    padding: 1rem clamp(1rem, 3vw, 3rem);
    border-inline: 1px solid var(--line);
    text-align: center;
  }
  .ed-weiter__mitte:hover {
    background: var(--fg);
    color: var(--bg);
  }
  @media (max-width: 700px) {
    .ed-weiter {
      grid-template-columns: 1fr 1fr;
    }
    .ed-weiter__mitte {
      grid-column: 1 / -1;
      grid-row: 2;
      border-inline: 0;
      border-top: 1px solid var(--line);
      min-height: 3.5rem;
    }
    .ed-weiter__link + .ed-weiter__mitte + .ed-weiter__link {
      border-left: 1px solid var(--line);
    }
  }
</style>
