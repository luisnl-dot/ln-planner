---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Abschluss from '../../components/Abschluss.astro';
import Bild from '../../components/Bild.astro';
import Fragen from '../../components/Fragen.astro';
import Kopf from '../../components/Kopf.astro';
import Pfeil from '../../components/Pfeil.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Status from '../../components/Status.astro';
import { gebrauchtFaq } from '../../data/faq';
import { haeuser } from '../../data/haeuser';
import { standorte } from '../../data/standorte';
import { bild } from '../../lib/bilder';

const modelle = (await getCollection('modelle')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const bmwPortal = 'https://gebrauchtfahrzeuge.bmw-motorrad.de/DE/ergebnisse.cshtml?hf=3&id=DE&RC=de-de&Buno=3070&sdl=1';
const zeile: Record<string, string> = {
  weyarn: 'Eine der größten Auswahlen gebrauchter BMW Motorräder in Oberbayern – Reiseenduros, Tourer, Roadster und Boxer-Klassiker.',
  schongau: 'Vom sofort fahrbereiten Alltagsmotorrad bis zum gepflegten Klassiker. Viele Maschinen kennen wir aus der eigenen Werkstatt.',
  'oy-mittelberg': 'Geprüft, gewartet und fahrbereit – mit Probefahrt auf Straßen, die etwas über ein Motorrad verraten.',
};
---

<Basis
  titel="Gebrauchte BMW Motorräder – geprüft in drei Häusern"
  beschreibung="Gebrauchte BMW Motorräder bei Motorrad Martin in Weyarn, Schongau und Oy-Mittelberg: geprüft, gewartet und mit nachvollziehbarer Historie. Bestand, Modell-Ratgeber und Inzahlungnahme."
  bildOg={bild('standorte/weyarn-halle-2')}
>
  <Seitenkopf
    krumen={[{ titel: 'Gebrauchte' }]}
    lines={['Gebrauchte']}
    rechts="Drei Häuser · ein Bestand"
    einleitung="Wir verkaufen kein Motorrad, das wir nicht selbst fahren würden. Jede Gebrauchtmaschine durchläuft vor der Übergabe unsere Werkstatt. Was ersetzt gehört, wird ersetzt – nicht beschönigt."
    bild={bild('standorte/weyarn-halle-2')}
    bildAlt="Halle voller gebrauchter BMW Motorräder in Weyarn"
  >
    <div class="stack">
      <p class="muted">Sie suchen etwas, das nicht im Bestand steht? Über unsere drei Standorte und unsere Kontakte im BMW Handel finden wir Ihre Maschine oft innerhalb weniger Tage.</p>
      <a class="btn btn--solid" href="/kontakt/?anliegen=gebraucht">Suchauftrag senden <Pfeil /></a>
    </div>
  </Seitenkopf>

  <section class="section section--flush-top">
    <div class="wrap">
      <Kopf nr="01" label="Bestand" titel="Der Bestand, Haus für Haus." />
      <ul class="bestand" role="list">
        {
          standorte.map((s, i) => (
            <li data-reveal style={`--i:${i}`}>
              <a class="bestand__karte" href={`/gebrauchte/${s.slug}/`}>
                <Bild src={bild(haeuser[s.slug].held)} alt="" ratio="43" sizes="(min-width: 900px) 30vw, 100vw" widths={[480, 800, 1200]} fokus={haeuser[s.slug].fokus} />
                <span class="label label--dim">{s.region}</span>
                <span class="bestand__ort">{s.ort}</span>
                <span class="muted">{zeile[s.slug]}</span>
                <span class="link">Bestand ansehen <Pfeil /></span>
              </a>
              <div class="bestand__fuss">
                <Status haus={s.slug} />
                <a class="mono" href={`tel:${s.tel}`}>{s.telefon}</a>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="bestand__mehr">
        <a class="btn" href={bmwPortal} target="_blank" rel="noopener">BMW Gebrauchtportal · Schongau <Pfeil raus /></a>
        <a class="btn" href="/gebrauchte/pkw/">Gebrauchte PKW <Pfeil /></a>
        <a class="btn" href="/ankauf/">Motorrad in Zahlung geben <Pfeil /></a>
      </div>
    </div>
  </section>

  <section class="section ratgeber" data-theme="dark" id="ratgeber">
    <div class="wrap">
      <Kopf nr="02" label="Modell-Ratgeber" titel="Worauf Sie beim Gebrauchtkauf achten sollten." rechts={`${modelle.length} Modelle`} />
      <ul class="ratgeber__liste" role="list">
        {
          modelle.map((m, i) => (
            <li data-reveal style={`--i:${Math.min(i, 6)}`}>
              <a href={`/gebrauchte/modelle/${m.id}/`}>
                <span class="mono dim">{String(i + 1).padStart(2, '0')}</span>
                <span class="ratgeber__modell">{m.data.modell}</span>
                <span class="label label--dim ratgeber__mehr">gebraucht kaufen</span>
                <Pfeil />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Kopf nr="03" label="Häufige Fragen" titel="Kurz beantwortet." />
      <Fragen fragen={gebrauchtFaq} />
    </div>
  </section>

  <Abschluss titel="Ihr Motorrad für ein neues?" text="Wir bewerten Ihre Maschine fair – als Inzahlungnahme oder als reinen Ankauf." knopf="Zum Ankauf" href="/ankauf/" knopf2="Probefahrt anfragen" href2="/kontakt/?anliegen=probefahrt" />
</Basis>

<style>
  .bestand {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem var(--gap);
  }
  .bestand__karte {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .bestand__karte :global(.bild) {
    width: 100%;
    margin-bottom: 0.4rem;
  }
  .bestand__karte :global(.bild img) {
    transition: transform 1.2s var(--ease);
  }
  .bestand__karte:hover :global(.bild img) {
    transform: scale(1.04);
  }
  .bestand__ort {
    display: inline-block;
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.6rem);
    font-weight: 800;
    font-stretch: 100%;
    letter-spacing: -0.035em;
    line-height: 0.95;
    transition: transform 0.6s var(--ease);
    text-transform: uppercase;
  }
  .bestand__karte:hover .bestand__ort {
  transform: translateX(0.35rem);
  }
  .bestand__fuss {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .bestand__mehr {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  @media (max-width: 900px) {
    .bestand {
      grid-template-columns: 1fr;
    }
  }
  .ratgeber__liste {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gap);
    border-top: 1px solid var(--fg);
  }
  .ratgeber__liste a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto 1.25rem;
    gap: 1rem;
    align-items: baseline;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--line);
    transition:
      padding 0.45s var(--ease),
      border-color 0.3s;
  }
  .ratgeber__modell {
    display: inline-block;
    font-size: clamp(1.4rem, 1rem + 1.6vw, 2.4rem);
    font-weight: 760;
    font-stretch: 100%;
    letter-spacing: -0.03em;
    line-height: 1;
    transition: transform 0.6s var(--ease);
    text-transform: uppercase;
  }
  .ratgeber__liste a:hover {
    padding-left: 0.75rem;
    border-bottom-color: var(--fg);
  }
  .ratgeber__liste a:hover .ratgeber__modell {
  transform: translateX(0.35rem);
  }
  @media (max-width: 1000px) {
    .ratgeber__liste {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .ratgeber__mehr {
      display: none;
    }
    .ratgeber__liste a {
      grid-template-columns: 2rem minmax(0, 1fr) 1.25rem;
      transition: padding 0.45s var(--ease),
      border-color 0.3s;
    }
  }
</style>
