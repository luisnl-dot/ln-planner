---
import Basis from '../../layouts/Basis.astro';
import Bild from '../../components/Bild.astro';
import Pfeil from '../../components/Pfeil.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import { bild } from '../../lib/bilder';

const varianten = [
  {
    href: '/',
    name: 'Das Tor',
    kurz: 'Aktuell live',
    text: 'Schlagzeile, darunter ein Bildfenster. Beim Scrollen öffnet sich das Fenster zur ganzen Bühne.',
    bild: 'editionen/r-18-bobber-2',
  },
  {
    href: '/varianten/durchblick/',
    name: 'Durchblick',
    kurz: 'Variante A',
    text: 'Ein großes MARTIN ist aus der Fläche gestanzt, durch die Buchstaben sieht man das Motorrad. Beim Scrollen fährt die Kamera durch das „I“ ins Vollbild.',
    bild: 'editionen/r-18-bobber-1',
  },
  {
    href: '/varianten/showroom/',
    name: 'Showroom',
    kurz: 'Variante B',
    text: 'Vollbild-Bühne. Beim Scrollen fahren vier Martin Editionen nacheinander von unten auf, jede rastet ein. Mobil wischt man seitwärts.',
    bild: 'editionen/r-1300-gs-adventure-rallye-dakar-1',
  },
  {
    href: '/varianten/haeuser/',
    name: 'Drei Häuser',
    kurz: 'Variante C',
    text: 'Drei hohe Bildsäulen – Schongau, Weyarn, Oy-Mittelberg – mit Live-Status. Beim Scrollen gleiten die Säulen unterschiedlich schnell, die Schlagzeile teilt sich. Hält das Scrollen nicht auf.',
    bild: 'standorte/weyarn-front',
  },
];
---

<Basis titel="Hero-Varianten" beschreibung="Vorschau: vier Varianten für den Auftakt der Startseite." noindex>
  <Seitenkopf krumen={[{ titel: 'Hero-Varianten' }]} lines={['Hero-Varianten']} rechts="Vorschau · nicht öffentlich" einleitung="Vier Varianten für den Auftakt der Startseite. Jede Variante zeigt die komplette Startseite – nur der erste Bildschirm und seine Scroll-Animation sind anders." />
  <section class="section section--flush-top">
    <div class="wrap">
      <ul class="var" role="list">
        {
          varianten.map((v) => (
            <li>
              <a class="var__karte" href={v.href}>
                <Bild src={bild(v.bild)} alt="" ratio="32" sizes="(min-width: 900px) 46vw, 100vw" widths={[480, 800, 1200]} />
                <span class="label label--dim">{v.kurz}</span>
                <span class="var__name">{v.name}</span>
                <span class="muted">{v.text}</span>
                <span class="link">Ansehen <Pfeil /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Basis>

<style>
  .var {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem var(--gap);
  }
  .var__karte {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .var__karte :global(.bild) {
    width: 100%;
    margin-bottom: 0.4rem;
  }
  .var__name {
    font-size: clamp(1.8rem, 1.2rem + 2vw, 3rem);
    font-weight: 800;
    font-stretch: 108%;
    letter-spacing: -0.035em;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .var__karte .muted {
    max-width: 46ch;
  }
  @media (max-width: 800px) {
    .var {
      grid-template-columns: 1fr;
    }
  }
</style>
