---
import { getCollection } from 'astro:content';
import Basis from '../layouts/Basis.astro';
import Bild from '../components/Bild.astro';
import EditionKarte from '../components/EditionKarte.astro';
import Fit from '../components/Fit.astro';
import JournalKarte from '../components/JournalKarte.astro';
import Karte from '../components/Karte.astro';
import Kopf from '../components/Kopf.astro';
import Massband from '../components/Massband.astro';
import Pfeil from '../components/Pfeil.astro';
import Status from '../components/Status.astro';
import { edition, editionen } from '../data/editionen';
import { standorte, routeUrl } from '../data/standorte';
import { bild } from '../lib/bilder';

const held = edition('r-18-bobber');
const schau = [
  'r-1300-gs-adventure-black',
  'r-ninet-100-rs',
  'r-12-ninet-big-foot-military',
  'r-1300-gs-supermoto-neon',
  'm-1000-rr-black',
  'r-ninet-90s-daytona',
  'r-12-gs-rallye-dakar-blue',
  'r-1300-gs-adventure-hunter',
].map(edition);

const leistungen = [
  { id: 'neu', titel: 'Neue BMW', text: 'Das aktuelle Programm – beraten, konfiguriert und übergeben in drei Häusern.', href: '/motorraeder/', bild: 'standorte/weyarn-laden-1' },
  { id: 'gebraucht', titel: 'Gebrauchte', text: 'Geprüft, gewartet und mit nachvollziehbarer Historie. Jede Maschine durchläuft unsere Werkstatt.', href: '/gebrauchte/', bild: 'standorte/weyarn-halle-2' },
  { id: 'werkstatt', titel: 'Werkstatt', text: 'Computergestützte Diagnose, geschultes Personal und Zugriff auf über 24.000 BMW Originalteile.', href: '/service/', bild: 'standorte/weyarn-werkstatt' },
  { id: 'mieten', titel: 'Mieten', text: 'Vom CE 02 bis zur M 1000 RR – tageweise, übers Wochenende oder für die ganze Woche.', href: '/mieten/', bild: 'standorte/weyarn-eingang' },
  { id: 'ankauf', titel: 'Ankauf', text: 'Ein solides, faires Angebot für Ihr Motorrad – als Inzahlungnahme oder ohne Neukauf.', href: '/ankauf/', bild: 'standorte/weyarn-beratung' },
  { id: 'winter', titel: 'Winter-Wellness', text: 'Einlagerung in trockenen, beheizten Hallen. Mit Batterieservice und Frühjahrscheck.', href: '/service/winter-wellness/', bild: 'standorte/schongau-halle' },
  { id: 'classic', titel: 'BMW Classic', text: 'Restaurierung und Instandsetzung klassischer BMW – vom Vergaser bis zum Zweiventilboxer.', href: '/service/bmw-classic/', bild: 'haus/classic-vorkrieg' },
];

const journal = (await getCollection('journal')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
const neues = [journal.find((j) => j.data.kategorie === 'martin-edition')!, ...journal.filter((j) => j.data.kategorie === 'neuheiten').slice(0, 2)];
const stellen = (await getCollection('jobs')).length;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Standorte von BMW Motorrad Martin',
    itemListElement: standorte.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: new URL(`/standorte/${s.slug}/`, Astro.site).href })),
  },
];
---

<Basis
  titel="BMW Motorrad Martin – Vertragshändler in Oberbayern & Allgäu"
  titelRoh
  beschreibung="BMW Motorrad Martin: Familienbetrieb seit 1954 mit drei Häusern in Schongau, Weyarn und Oy-Mittelberg. Neue und gebrauchte BMW Motorräder, Werkstatt, Vermietung – und die Manufaktur der Martin Edition."
  schema={schema}
>
  <!-- ============ Auftakt: das Tor ============ -->
  <section class="start" data-tor data-kopf="hell">
    <div class="start__innen wrap">
      <p class="start__ober label" data-tor-vorn>
        <span>BMW Motorrad Vertragshändler</span>
        <span class="dim start__orte">Schongau · Weyarn · Oy-Mittelberg</span>
        <span class="start__live">
          {
            standorte.map((s) => (
              <a href={`/standorte/${s.slug}/`}>
                <Status haus={s.slug} ort />
              </a>
            ))
          }
        </span>
      </p>

      <Fit tag="h1" class="start__titel" lines={['Kein gewöhnlicher', 'BMW Partner.']} linesSm={['Kein', 'gewöhnlicher', 'BMW Partner.']} label="Kein gewöhnlicher BMW Partner." />

      <div class="start__unten">
        <div class="start__text" data-tor-vorn>
          <p class="lead" data-reveal style="--i:3">
            Familienbetrieb seit 1954, heute in dritter Generation. Drei Häuser am Alpenrand – und eine eigene Manufaktur, in der aus BMW Motorrädern Einzelstücke werden.
          </p>
          <div class="start__aktionen" data-reveal style="--i:4">
            <a class="btn btn--solid" href="/martin-edition/">Martin Edition ansehen <Pfeil /></a>
            <a class="btn" href="/kontakt/?anliegen=probefahrt">Probefahrt anfragen <Pfeil /></a>
          </div>
          <ul class="start__status" role="list">
            {
              standorte.map((s) => (
                <li>
                  <a href={`/standorte/${s.slug}/`}>
                    <Status haus={s.slug} ort />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="start__platz" data-tor-platz>
          <div class="start__film" data-tor-film>
            <div class="start__bild" data-tor-bild>
              <Bild src={bild(`editionen/${held.slug}-2`)} alt={`${held.titel} im Gegenlicht vor den Bergen`} sizes="(min-width: 900px) 100vw, 100vw" widths={[640, 960, 1280, 1800]} eager />
            </div>
            <div class="start__schleier" data-tor-schleier aria-hidden="true"></div>
            <div class="start__etikett wrap" data-tor-etikett>
              <a class="start__etikett-link" href={`/martin-edition/${held.slug}/`}>
                <span class="label">Martin Edition · Katalog Nº {held.nr}</span>
                <span class="start__etikett-name">BMW {held.basis} {held.name}</span>
                <span class="link">Zur Edition <Pfeil /></span>
              </a>
              <span class="label start__weiter" aria-hidden="true">Weiter ↓</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Manufaktur ============ -->
  <section class="manu" data-theme="dark">
    <div class="wrap manu__kopf">
      <Kopf nr="01" label="Manufaktur" rechts={`${editionen.length} Editionen in der Kollektion`} />
      <div class="manu__auftakt">
        <Fit tag="h2" lines={['Martin', 'Edition']} class="manu__titel" label="Martin Edition" />
        <div class="manu__text">
          <p class="lead" data-reveal>Unter dem Namen Martin Edition entstehen veredelte BMW Motorräder in Handarbeit – streng limitiert, jedes ein Einzelstück.</p>
          <p class="muted mt2 measure-s" data-reveal style="--i:1">Wir bauen Ihnen Ihr Motorrad nach Ihren Wünschen um. Für BMW gibt es eine breite Palette von Umbauteilen – wir geben Ihnen gerne Auskunft über die Möglichkeiten eines sinnvollen An- oder Umbaus.</p>
          <a class="btn mt3" href="/martin-edition/" data-reveal style="--i:2">Zur Kollektion <Pfeil /></a>
        </div>
      </div>
    </div>

    <div class="schau" data-horizontal>
      <div class="schau__band" data-band data-lenis-prevent-touch>
        {
          schau.map((e, i) => (
            <div class="schau__tafel">
              <EditionKarte e={e} sizes="(min-width: 900px) 46vw, 86vw" />
            </div>
          ))
        }
        <a class="schau__ende" href="/martin-edition/">
          <span class="label label--dim">Kollektion</span>
          <span class="schau__ende-zahl">{editionen.length}</span>
          <span class="h3">Alle Editionen ansehen</span>
          <Pfeil />
        </a>
      </div>
      <div class="schau__fuss wrap">
        <span class="label label--dim nur-desktop">Weiterscrollen</span>
        <span class="label label--dim nur-mobil">Wischen</span>
        <span class="schau__balken" aria-hidden="true"><i data-fortschritt></i></span>
        <span class="label label--dim">{String(schau.length).padStart(2, '0')} von {editionen.length}</span>
      </div>
    </div>
  </section>

  <!-- ============ Kennwerte ============ -->
  <section class="section section--tight werte">
    <div class="wrap">
      <ul class="werte__liste" role="list">
        <li data-reveal>
          <span class="werte__zahl">1954</span>
          <span class="label">gegründet</span>
          <span class="muted">Erwin Martin, Ingenried bei Schongau. Tankstelle, Kfz-Reparatur, Werksvertretung.</span>
        </li>
        <li data-reveal style="--i:1">
          <span class="werte__zahl">3.</span>
          <span class="label">Generation</span>
          <span class="muted">In Familienhand – keine Kette, kein Investor.</span>
        </li>
        <li data-reveal style="--i:2">
          <span class="werte__zahl">3</span>
          <span class="label">Häuser</span>
          <span class="muted">Schongau, Weyarn und Oy-Mittelberg – jedes mit eigenem Team.</span>
        </li>
        <li data-reveal style="--i:3">
          <span class="werte__zahl">24.000</span>
          <span class="label">Originalteile im Zugriff</span>
          <span class="muted">Nicht vorrätige Teile kommen in der Regel innerhalb von 24 Stunden.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============ Leistungen ============ -->
  <section class="section section--flush-top">
    <div class="wrap">
      <Kopf nr="02" label="Leistungen" titel="Was können wir für Sie tun?">
        <a slot="seite" class="link" href="/kontakt/">Direkt anfragen <Pfeil /></a>
      </Kopf>
      <div class="leist" data-register>
        <ul class="leist__liste" role="list">
          {
            leistungen.map((l, i) => (
              <li data-zeile={l.id} data-reveal style={`--i:${Math.min(i, 5)}`}>
                <a class="leist__zeile" href={l.href}>
                  <span class="label dim">{String(i + 1).padStart(2, '0')}</span>
                  <span class="leist__titel">{l.titel}</span>
                  <span class="leist__text muted">{l.text}</span>
                  <Pfeil />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="leist__vorschau" data-vorschau aria-hidden="true">
          {
            leistungen.map((l) => (
              <div class="leist__vorschau-bild" data-vorschau-bild={l.id}>
                <Bild src={bild(l.bild)} alt="" ratio="43" sizes="360px" widths={[480, 800]} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Drei Häuser ============ -->
  <section class="section haeuser">
    <div class="wrap">
      <Kopf nr="03" label="Standorte" titel="Drei Häuser, rund 100 Kilometer Alpenrand.">
        <a slot="seite" class="link" href="/standorte/">Alle Standorte <Pfeil /></a>
      </Kopf>
      <div class="haeuser__raster">
        <Karte class="haeuser__karte" data-reveal />
        <ul class="haeuser__liste" role="list">
          {
            standorte.map((s, i) => (
              <li class="haus-karte" data-haus-karte={s.slug} data-reveal style={`--i:${i}`}>
                <div class="haus-karte__kopf">
                  <a class="haus-karte__name" href={`/standorte/${s.slug}/`}>
                    {s.ort}
                  </a>
                  <Status haus={s.slug} />
                </div>
                <p class="label label--dim">{s.rolle}</p>
                <p class="muted haus-karte__text">{s.anfahrt}</p>
                <p class="haus-karte__adresse">
                  {s.strasse}, {s.plz} {s.ort}
                </p>
                <div class="haus-karte__aktionen">
                  <a class="link" href={`tel:${s.tel}`}>
                    {s.telefon}
                  </a>
                  <a class="link" href={routeUrl(s)} target="_blank" rel="noopener">
                    Route <Pfeil raus />
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ Seit 1954 ============ -->
  <section class="section seit">
    <div class="wrap">
      <Kopf nr="04" label="Geschichte" titel="Präzision seit 1954.">
        <a slot="seite" class="link" href="/ueber-uns/">Die ganze Geschichte <Pfeil /></a>
      </Kopf>
      <div class="seit__raster">
        <p class="lead seit__text" data-reveal>
          Was 1954 als Familienbetrieb begann, wird heute in dritter Generation geführt: BMW Martin ist einer der größten BMW Motorrad Händler in Deutschland.
        </p>
        <Massband />
      </div>
    </div>
  </section>

  <!-- ============ Journal ============ -->
  <section class="section section--flush-top">
    <div class="wrap">
      <Kopf nr="05" label="Journal" titel="Neues aus Haus und Halle.">
        <a slot="seite" class="link" href="/journal/">Alle Beiträge <Pfeil /></a>
      </Kopf>
      <div class="neues">
        <JournalKarte eintrag={neues[0]} gross sizes="(min-width: 1000px) 58vw, 100vw" />
        <div class="neues__seite">
          {neues.slice(1).map((n, i) => <JournalKarte eintrag={n} i={i + 1} sizes="(min-width: 1000px) 30vw, 100vw" />)}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Karriere ============ -->
  <section class="section karriere-band" data-theme="dark">
    <div class="wrap karriere-band__raster">
      <div>
        <p class="label label--dim">06 — Karriere</p>
        <p class="h2 mt2" data-reveal>Wer bei uns anfängt, schraubt nicht nur an Serienmaschinen – sondern baut an einer eigenen Marke mit.</p>
      </div>
      <div class="karriere-band__seite" data-reveal style="--i:1">
        <p class="karriere-band__zahl">{stellen}</p>
        <p class="label">offene Stellen in Schongau, Weyarn und Oy-Mittelberg</p>
        <a class="btn btn--solid mt2" href="/karriere/">Stellen ansehen <Pfeil /></a>
      </div>
    </div>
  </section>
</Basis>

<style>
  /* ---------- Auftakt ---------- */
  .start {
    position: relative;
    min-height: max(100svh, 40rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--paper);
    overflow: clip;
  }
  .start__innen {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto 1fr;
    padding-top: calc(var(--header-h) + clamp(0.5rem, 2vh, 1.5rem));
    padding-bottom: var(--pad);
    min-height: 0;
  }
  .start__ober {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(0.5rem, 1.6vh, 1.1rem);
    border-bottom: 1px solid var(--ink);
  }
  .start__orte,
  .start__live {
    display: none;
  }
  @media (min-width: 560px) {
    .start__orte {
      display: inline;
    }
  }
  @media (min-width: 1240px) {
    .start__orte {
      display: none;
    }
    .start__live {
      display: flex;
      gap: clamp(1rem, 2vw, 2.25rem);
    }
    .start__status {
      display: none !important;
    }
  }
  .start__live a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  :global(.start__titel) {
    margin-top: clamp(0.6rem, 2vh, 1.4rem);
  }
  .start__unten {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    margin-top: clamp(1rem, 2.6vh, 2rem);
    min-height: 0;
  }
  .start__text {
    grid-column: 1 / span 4;
    align-self: end;
    display: grid;
    gap: clamp(1rem, 2.4vh, 1.75rem);
    padding-right: 1rem;
  }
  .start__text .lead {
    font-size: clamp(1.05rem, 0.85rem + 0.72vw, 1.45rem);
  }
  .start__aktionen {
    display: grid;
    gap: 0.5rem;
    max-width: 23rem;
  }
  .start__status {
    display: grid;
    gap: 0.35rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .start__status a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .start__platz {
    grid-column: 5 / -1;
    min-height: clamp(14rem, 36vh, 30rem);
    position: static;
  }
  .start__film {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--night);
  }
  .start__bild,
  .start__bild :global(.bild) {
    width: 100%;
    height: 100%;
  }
  .start__bild :global(img) {
    object-position: 50% 58%;
  }
  .start__schleier {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(11 12 12 / 0.62), transparent 26%),
      linear-gradient(to top, rgb(11 12 12 / 0.78), transparent 42%);
    opacity: 0;
    pointer-events: none;
  }
  .start__etikett {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    padding-bottom: clamp(1rem, 3vh, 2.25rem);
    color: var(--chalk);
  }
  .start__etikett-link {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .start__etikett-name {
    font-size: clamp(1.4rem, 1rem + 2.4vw, 3.4rem);
    font-weight: 780;
    font-stretch: 112%;
    letter-spacing: -0.03em;
    line-height: 0.98;
    text-transform: uppercase;
  }
  .start__weiter {
    display: none;
  }
  /* statischer Zustand (mobil, ohne JS, reduzierte Bewegung): Etikett sitzt im Bild */
  .start:not(.tor-aktiv) .start__schleier {
    opacity: 1;
    background: linear-gradient(to top, rgb(11 12 12 / 0.8), transparent 55%);
  }
  .start:not(.tor-aktiv) .start__etikett {
    padding-inline: 1rem;
    padding-bottom: 1rem;
  }
  .start:not(.tor-aktiv) .start__etikett-name {
    font-size: clamp(1.15rem, 0.9rem + 1.2vw, 1.8rem);
  }
  /* aktiver Zustand: Film liegt über der ganzen Bühne und wird freigeschnitten */
  .start.tor-aktiv {
    height: 100svh;
    min-height: 0;
  }
  .start.tor-aktiv .start__platz {
    min-height: 0;
  }
  .start.tor-aktiv .start__film {
    position: absolute;
    inset: 0;
    z-index: 3;
    will-change: clip-path;
  }
  .start.tor-aktiv .start__bild {
    will-change: transform;
  }
  .start.tor-aktiv .start__weiter {
    display: block;
  }
  @media (max-width: 899px) {
    .start {
      min-height: 0;
    }
    .start__unten {
      display: flex;
      flex-direction: column-reverse;
      gap: 1.5rem;
    }
    .start__text {
      padding-right: 0;
    }
    .start__platz {
      aspect-ratio: 4 / 3;
      min-height: 0;
    }
    .start__aktionen {
      max-width: none;
    }
  }

  /* ---------- Manufaktur ---------- */
  .manu {
    background: var(--bg);
    color: var(--fg);
    padding-top: clamp(3.5rem, 8vw, 8rem);
  }
  .manu__auftakt {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 2.5rem;
    align-items: end;
  }
  :global(.manu__titel) {
    grid-column: 1 / span 8;
  }
  .manu__text {
    grid-column: 10 / -1;
    padding-bottom: 0.6rem;
  }
  @media (max-width: 1400px) {
    .manu__text {
      grid-column: 9 / -1;
    }
  }
  @media (max-width: 1000px) {
    :global(.manu__titel),
    .manu__text {
      grid-column: 1 / -1;
    }
  }
  .schau {
    position: relative;
    overflow-x: clip;
    margin-top: clamp(3rem, 6vw, 6rem);
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }
  .schau__band {
    display: flex;
    gap: var(--gap);
    padding-inline: var(--pad);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .schau__band::-webkit-scrollbar {
    display: none;
  }
  .schau__tafel {
    flex: 0 0 min(86vw, 46rem);
    scroll-snap-align: center;
  }
  .schau__ende {
    flex: 0 0 min(70vw, 26rem);
    scroll-snap-align: center;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.75rem;
    padding: 2rem;
    border: 1px solid var(--line-2);
    aspect-ratio: 3 / 2;
    align-self: start;
    transition:
      background 0.4s,
      color 0.4s;
  }
  .schau__ende:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .schau__ende-zahl {
    font-size: clamp(4rem, 9vw, 9rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.82;
    letter-spacing: -0.04em;
  }
  .schau__fuss {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .schau__balken {
    flex: 1;
    height: 1px;
    background: var(--line);
    position: relative;
  }
  .schau__balken i {
    position: absolute;
    inset: -0.5px 0;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
  }
  /* an den Scroll gekoppelt (Desktop) */
  :global(.schau.ist-gekoppelt) {
    height: 100svh;
    margin-top: 0;
    padding-bottom: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
  }
  :global(.schau.ist-gekoppelt) .schau__band {
    overflow: visible;
    scroll-snap-type: none;
    width: max-content;
    will-change: transform;
  }
  :global(.schau.ist-gekoppelt) .schau__tafel {
    flex-basis: min(46vw, calc((100svh - 17rem) * 1.5));
  }
  :global(.schau.ist-gekoppelt) .schau__ende {
    flex-basis: min(30vw, 28rem);
  }

  /* ---------- Kennwerte ---------- */
  .werte__liste {
    display: grid;
